APP_NAME='Ecommerce'
APP_ENV=local
APP_DEBUG=1
APP_URL=https://ecommerce.moi
APP_TIMEZONE='Asia/Dhaka'

DB_SERVER='db'
DB_USERNAME='root'
DB_PASSWORD='root'
DB_DATABASE='ecommerce'

# রেসপন্সে EL#line_file ডিবাগ কি গুলো যাবে কি না
RESPONSE_DEBUG=1

# টোকেন কত সেকেন্ড বাঁচবে (৩০ দিন)
API_TOKEN_TTL=2592000

# অ্যাডমিন সেশন কত সেকেন্ড নিষ্ক্রিয় থাকলে অটো লগআউট (২০ মিনিট, sliding —
# প্রতিটা রিকোয়েস্টে বেড়ে যায়)। কাস্টমার সেশনে এই টাইমআউট প্রযোজ্য না।
# doc/13-auth-and-user-management.md
ADMIN_SESSION_TTL=1200

PAGE_TITLE_PREFIX=''
